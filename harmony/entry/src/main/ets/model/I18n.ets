export function tr(text: string): string {
  if (i18n.System.getAppPreferredLanguage().toLowerCase().startsWith('zh')) { return text; }
  return ENGLISH.get(text) ?? text.replace(/^远端终端已退出（(-?\d+)）$/, 'Remote terminal exited ($1)');
}
