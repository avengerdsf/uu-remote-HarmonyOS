export function iconResource(key: string, dark: boolean, selected: boolean): Resource {
  if (key === 'fullscreen') { return $r('app.media.toolbar_fullscreen'); }
  const variant = selected ? (dark ? 'selected_dark' : 'selected_light') : (dark ? 'dark' : 'light');
  return ICON_MAP[`${key}_${variant}`];
}
